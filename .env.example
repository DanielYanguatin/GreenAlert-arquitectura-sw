# ─────────────────────────────────────────────────────────────────────────────
# GreenAlert · Variables de entorno (PLANTILLA)
# Copie este archivo a .env y reemplace TODOS los valores "cambiar-...".
# Genere secretos con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# El archivo .env está en .gitignore: nunca lo suba al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno
NODE_ENV=production

# Secretos compartidos (mínimo 32 y 24 caracteres respectivamente)
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
INTERNAL_API_KEY=cambiar-por-una-clave-interna-aleatoria
JWT_EXPIRES_IN_SECONDS=3600

# Administrador inicial (se crea solo si no existe ningún ADMIN)
ADMIN_EMAIL=admin@greenalert.local
ADMIN_PASSWORD=cambiar-Admin123

# MySQL (un usuario por servicio: Database per Service)
MYSQL_ROOT_PASSWORD=cambiar-root
USERS_DB_PASSWORD=cambiar-users
REPORTS_DB_PASSWORD=cambiar-reports
MULTIMEDIA_DB_PASSWORD=cambiar-multimedia
GEOLOCATION_DB_PASSWORD=cambiar-geolocation
AI_DB_PASSWORD=cambiar-ai
NOTIFICATIONS_DB_PASSWORD=cambiar-notifications

# Gateway
GATEWAY_PORT=3000
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
PROXY_TIMEOUT_MS=15000
REVOCATION_CACHE_TTL_MS=30000

# Comunicación entre servicios
HTTP_TIMEOUT_MS=3000
OUTBOX_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=10

# Multimedia
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_REPORT=5

# Inteligencia artificial: heuristic (servicio de prueba, NO entrenado) | http (modelo externo)
AI_PROVIDER=heuristic
AI_MODEL_URL=
AI_MODEL_TIMEOUT_MS=10000

# Notificaciones (por defecto Mailpit, servidor SMTP de desarrollo)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GreenAlert <no-reply@greenalert.local>
NOTIFICATIONS_MAX_ATTEMPTS=6

# Frontend
FRONTEND_PORT=8080

# Calidad: umbral de cobertura configurable (ver docs/12-informe-calidad-codigo.md §5)
COVERAGE_THRESHOLD=0
